openfde_sdk_src = "sdk/src/java/openfde"
library_src = "openfde/lib/main/java"

// READ ME: ########################################################
//
// When updating this list of aidl files, consider if that aidl is
// part of the SDK API.  If it is, also add it to the list below that
// is preprocessed and distributed with the SDK. This list should
// not contain any aidl files for parcelables, but the one below should
// if you intend for 3rd parties to be able to send those objects
// across process boundaries.
//
// READ ME: ########################################################

java_library {
    name: "org.openfde.platform",
    installable: true,
    sdk_version: "core_platform",

    libs: [
        "framework",
        "services",
    ],

    srcs: [
        openfde_sdk_src + "/**/*.java",
        library_src + "/**/*.java",
        openfde_sdk_src + "/**/I*.aidl",
        "sdk/src/java/android/**/*.java",
        "sdk/src/java/android/**/I*.aidl",
    ],

    // Include aidl files from app namespace as well as internal src aidl files
    aidl: {
        local_include_dirs: ["sdk/src/java"],
    },
}

// Full target for use by platform apps
// ============================================================

java_library {
    name: "org.openfde.platform.internal",

    srcs: [
        openfde_sdk_src + "/**/*.java",
        openfde_sdk_src + "/**/I*.aidl",
	    "sdk/src/java/android/**/*.java",
        "sdk/src/java/android/**/I*.aidl",
    ],

    aidl: {
        local_include_dirs: ["sdk/src/java"],
    },
}

// The SDK
// ============================================================

// Included aidl files from app namespace

java_library {
    name: "org.openfde.platform.sdk",
    required: ["services"],

    srcs: [
        openfde_sdk_src + "/**/*.java",
        openfde_sdk_src + "/**/I*.aidl",
    ],

    aidl: {
        local_include_dirs: ["sdk/src/java"],
    },
}

java_library {
    name: "org.openfde.platform.connectivity",
    min_sdk_version: "30",
    sdk_version: "system_server_current",
    platform_apis: true,

    srcs: [
        "sdk/src/java/android/openfde/Net.java",
        "sdk/src/java/android/openfde/INet.aidl",
    ],

    // List of apex modules that can link against this lib
    apex_available: [
        "com.android.tethering",
    ],
}

// The openfde SDK
// ============================================================

java_library {
    name: "openfde_sdk",
    srcs: [
           "sdk/src/java/android/openfde/AppTaskControllerProxy.java",
           "sdk/src/java/android/openfde/AppTaskStatusListener.java",
           "sdk/src/java/android/openfde/SystemBarOperator.java",
           "sdk/src/java/android/openfde/WmShellCaller.java",
    ],

    platform_apis: true,

    libs: [
        "framework",
    ],

    installable: false,
}

java_library {
    name: "org.openfde.platform.bluetooth",
    min_sdk_version: "30",
    platform_apis: true,
    sdk_version: "module_current",

    srcs: [
        "sdk/src/java/android/openfde/Bluetooth.java",
        "sdk/src/java/android/openfde/IBluetooth.aidl",
        "sdk/src/java/android/openfde/IBluetoothCallback.aidl",
    ],

    apex_available: [
        "com.android.btservices",
    ],
}
java_library {
    name: "org.openfde.platform.p2p",
    min_sdk_version: "30",
    platform_apis: true,
    sdk_version: "module_current",

    srcs: [
        "sdk/src/java/android/openfde/P2p.java",
        "sdk/src/java/android/openfde/IP2p.aidl",
        "sdk/src/java/android/openfde/IP2pCallback.aidl",
    ],
    visibility: [
        "//packages/modules/Wifi/service",
    ],

    apex_available: [
        "com.android.wifi",
    ],
    installable:true,
}
